name: Claude Review on Push

on:
  push:
    branches: [main]

concurrency:
  group: claude-review-${{ github.ref }}
  cancel-in-progress: true

jobs:
  review:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write      # 貼 commit comment 需要
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 2   # 要有前一個 commit 才能 diff

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - run: npm ci

      - name: Lint
        run: npm run lint 2>&1 | tee lint.log || true

      - name: Test
        run: npm test 2>&1 | tee test.log || true

      - name: Claude review
        env:
          RAW_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        run: |
          # 貼進 GitHub secret 時 token 可能被換行切斷,這裡去掉所有空白字元
          export CLAUDE_CODE_OAUTH_TOKEN="$(printf '%s' "$RAW_TOKEN" | tr -d '[:space:]')"
          if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
            echo "CLAUDE_CODE_OAUTH_TOKEN 未設定" > review.md
            exit 1
          fi

          npm install -g @anthropic-ai/claude-code

          git diff HEAD~1 HEAD > commit.diff || git show HEAD > commit.diff
          {
            echo "===== 本次 commit 的 diff ====="
            cat commit.diff
            echo "===== lint.log ====="
            cat lint.log 2>/dev/null || echo "(無)"
            echo "===== test.log ====="
            cat test.log 2>/dev/null || echo "(無)"
          } > context.txt

          cat context.txt | claude -p "$(cat <<'PROMPT'
          你收到的 stdin 是本次 commit 的 diff,以及 lint 與 test 的輸出。
          請依專案根目錄 CLAUDE.md 所列的慣例審查這份 diff。

          重點:會靜默丟資料或算錯數字的 bug、前後端重複實作、
          與既有邏輯衝突之處、lint/test 是否有失敗、測試是否涵蓋這次改動。

          沒問題就直接說沒問題,不要湊字數。
          有問題時指出檔案與行號,並說明會在什麼情況下出錯。
          需要時可用 Read / Grep 讀取 repo 內其他檔案佐證。

          用繁體中文輸出 Markdown,300 字以內,不要加標題以外的裝飾。
          PROMPT
          )" \
            --model claude-sonnet-5 \
            --allowedTools "Read,Grep,Glob" \
            --permission-mode dontAsk \
            --output-format text > review.md

          echo "--- review.md ---"
          cat review.md

      - name: Post review as commit comment
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          [ -s review.md ] || { echo "review.md 是空的,略過"; exit 0; }
          gh api "repos/${{ github.repository }}/commits/${{ github.sha }}/comments" \
            -f body="$(cat review.md)"
